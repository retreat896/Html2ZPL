{
    "name": "worker",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "deploy": "wrangler deploy",
        "dev": "concurrently --kill-others --names backend,frontend --prefix-colors green,cyan \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
        "build": "npm run build --prefix frontend",
        "start": "wrangler dev",
        "test": "vitest"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.6.0",
        "concurrently": "^9.2.1",
        "vitest": "^4.1.12",
        "wrangler": "^4.158.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "hono": "^4.11.4",
        "jsonwebtoken": "^9.0.3"
    }
}
